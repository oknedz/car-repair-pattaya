              <div className="mb-4">
                <Image 
                  src="/logo.svg" 
                  alt={t[language].logo} 
                  width={120} 
                  height={36}
                  className="h-8 w-auto mb-4"
                />
              </div>
              <p className="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                {language === 'th' 
                  ? 'ศูนย์บริการซ่อมรถยนต์มืออาชีพ ไว้ใจได้ ราคายุติธรรม' 
                  : 'Professional car service you can trust with honest pricing'}
              </p>
            </div>

            {/* Contact Info */}
            <div>
              <h3 className="font-bold text-[#1E293B] dark:text-white mb-4 text-sm uppercase tracking-wide">{t[language].footerContact}</h3>
              <div className="space-y-3">
                <a href="tel:+66123456789" className="flex items-center gap-3 text-slate-600 dark:text-slate-400 hover:text-[#3B82F6] transition-colors group">
                  <div className="w-10 h-10 rounded-lg bg-slate-100 dark:bg-white flex items-center justify-center group-hover:bg-[#C5A059] group-hover:text-white transition-all">
                    <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <span className="text-sm">012-345-6789</span>
                </a>
                <a href="mailto:info@autofix.com" className="flex items-center gap-3 text-slate-600 dark:text-slate-400 hover:text-[#3B82F6] transition-colors group">
                  <div className="w-10 h-10 rounded-lg bg-slate-100 dark:bg-white flex items-center justify-center group-hover:bg-[#C5A059] group-hover:text-white transition-all">
                    <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <span className="text-sm">info@autofix.com</span>
                </a>
              </div>
            </div>

            {/* Hours & Payment */}
            <div>
              <h3 className="font-bold text-[#1E293B] dark:text-white mb-4 text-sm uppercase tracking-wide">{t[language].footerHours}</h3>
              <div className="space-y-2 mb-6">
                <div className="flex justify-between text-sm">
                  <span className="text-slate-600 dark:text-slate-400">{t[language].mon}</span>
                  <span className="text-[#1E293B] dark:text-white font-semibold">08:00-18:00</span>
                </div>
                <div className="flex justify-between text-sm">
                  <span className="text-slate-600 dark:text-slate-400">{t[language].sat}</span>
                  <span className="text-[#1E293B] dark:text-white font-semibold">08:00-17:00</span>
                </div>
                <div className="flex justify-between text-sm">
                  <span className="text-slate-600 dark:text-slate-400">{t[language].sun}</span>
                  <span className="text-red-500 font-semibold">{t[language].closed}</span>
                </div>
              </div>
              <div>
                <p className="text-xs text-slate-500 dark:text-slate-500 mb-2 uppercase tracking-wide">{t[language].footerPayment}</p>
                <div className="flex flex-wrap gap-2">
                  <span className="px-2 py-1 bg-slate-100 dark:bg-white text-slate-600 rounded text-xs">PromptPay</span>
                  <span className="px-2 py-1 bg-slate-100 dark:bg-white text-slate-600 rounded text-xs">Cash</span>
                  <span className="px-2 py-1 bg-slate-100 dark:bg-white text-slate-600 rounded text-xs">Cards</span>
                </div>
              </div>
            </div>
          </div>

          {/* Bottom Bar */}
          <div className="border-t border-slate-200 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <p className="text-slate-500 text-sm text-center md:text-left">
              {t[language].footerCopyright}
            </p>
            <div className="flex gap-4">
              <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" className="w-10 h-10 rounded-lg bg-slate-100 dark:bg-white hover:bg-[#1877F2] hover:text-white flex items-center justify-center transition-all">
                <svg className="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
              <a href="https://line.me" target="_blank" rel="noopener noreferrer" className="w-10 h-10 rounded-lg bg-slate-100 dark:bg-white hover:bg-[#06C755] hover:text-white flex items-center justify-center transition-all">
                <Image src="/line.svg" alt="LINE" width={20} height={20} className="rounded-full" />
              </a>
            </div>
          </div>
        </div>
      </footer>

      {/* Sticky Mobile Action Bar */}
      <div className="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-white dark:bg-slate-50 border-t border-slate-200 shadow-2xl">
        <div className="grid grid-cols-3 divide-x divide-slate-200 dark:divide-slate-700">
          <a 
            href="tel:+66123456789" 
            className="flex flex-col items-center justify-center py-3 px-2 active:bg-slate-100 dark:active:bg-slate-800 transition-colors"
          >
            <svg className="w-6 h-6 text-[#3B82F6] mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span className="text-xs font-semibold text-[#1E293B] dark:text-white">{language === 'th' ? 'โทร' : 'Call'}</span>
          </a>
          
          <button 
            onClick={() => setShowMap(true)}
            className="flex flex-col items-center justify-center py-3 px-2 active:bg-slate-100 dark:active:bg-slate-800 transition-colors"
          >
            <svg className="w-6 h-6 text-[#10B981] mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span className="text-xs font-semibold text-[#1E293B] dark:text-white">{language === 'th' ? 'แผนที่' : 'Maps'}</span>
          </button>
          
          <a 
            href="https://line.me" 
            target="_blank" 
            rel="noopener noreferrer"
            className="flex flex-col items-center justify-center py-3 px-2 active:bg-slate-100 dark:active:bg-slate-800 transition-colors"
          >
            <div className="w-6 h-6 mb-1 flex items-center justify-center">
              <Image src="/line.svg" alt="LINE" width={24} height={24} className="rounded-full" />
            </div>
            <span className="text-xs font-semibold text-[#1E293B] dark:text-white">LINE</span>
          </a>
        </div>
      </div>

      {/* Booking Modal */}
      {showBooking && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4 overflow-y-auto" onClick={() => setShowBooking(false)}>
          <div className="bg-white dark:bg-white rounded-2xl max-w-md w-full shadow-2xl my-8 max-h-[90vh] overflow-y-auto" onClick={(e) => e.stopPropagation()}>
            <div className="p-6 border-b border-slate-200 flex items-center justify-between">
              <h3 className="text-xl font-bold text-[#1E293B] dark:text-white">{t[language].bookingTitle}</h3>
              <button onClick={() => setShowBooking(false)} className="text-2xl hover:bg-slate-100 dark:hover:bg-slate-700 w-8 h-8 rounded-lg transition-colors text-slate-800">×</button>
            </div>
            
            {/* Progress Steps */}
            <div className="flex items-center justify-center gap-2 p-6 pb-4">
              {[1, 2, 3].map((step) => (
                <div key={step} className="flex items-center">
                  <div className={`w-8 h-8 rounded-full flex items-center justify-center font-semibold transition-all ${bookingStep >= step ? 'bg-[#C5A059] text-white' : 'bg-slate-200 dark:bg-slate-100 text-slate-500'}`}>
                    {step}
                  </div>
                  {step < 3 && <div className={`w-12 h-1 ${bookingStep > step ? 'bg-[#C5A059]' : 'bg-slate-200 dark:bg-slate-100'}`} />}
                </div>
              ))}
            </div>

            <div className="p-6 pt-2">
              {/* Step 1: Contact Info */}
              {bookingStep === 1 && (
                <div className="space-y-4">
                  <div>
                    <label className="block text-sm font-medium mb-2">{t[language].step1Name}</label>
                    <input type="text" className="w-full px-4 py-2 rounded-lg border border-slate-200 bg-white dark:bg-slate-50 text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#3B82F6]" placeholder={language === 'th' ? 'สมชาย ใจดี' : 'John Doe'} />
                  </div>
                  <div>
                    <label className="block text-sm font-medium mb-2">{t[language].step1Phone}</label>
                    <input type="tel" className="w-full px-4 py-2 rounded-lg border border-slate-200 bg-white dark:bg-slate-50 text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#3B82F6]" placeholder="+66 12-345-6789" />
                  </div>
                  <div>
                    <label className="block text-sm font-medium mb-2">{t[language].step1Email}</label>
                    <input type="email" className="w-full px-4 py-2 rounded-lg border border-slate-200 bg-white dark:bg-slate-50 text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#3B82F6]" placeholder="john@example.com" />
                  </div>
                  <button onClick={() => setBookingStep(2)} className="w-full px-6 py-3 rounded-lg bg-[#C5A059] text-white font-semibold hover:bg-[#B8935A] hover:scale-105 transition-all">
                    {t[language].next}
                  </button>
                </div>
              )}

              {/* Step 2: Service Selection */}
              {bookingStep === 2 && (
                <div className="space-y-4">
                  <div>
                    <label className="block text-sm font-medium mb-2">{t[language].step2Service}</label>
                    <select className="w-full px-4 py-2 rounded-lg border border-zinc-300 dark:border-[#FBBF24] bg-white dark:bg-white text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-[#FBBF24]">
                      <option>Oil Change</option>
                      <option>Brake Service</option>
                      <option>Engine Diagnostics</option>
                      <option>Tire Service</option>
                      <option>Battery Check</option>
                      <option>AC Repair</option>
                      <option>Transmission</option>
                      <option>Full Inspection</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-sm font-medium mb-2">{t[language].step2Vehicle}</label>
                    <input type="text" className="w-full px-4 py-2 rounded-lg border border-slate-200 bg-white dark:bg-slate-50 text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#3B82F6]" placeholder={language === 'th' ? 'เช่น โตโยต้า คัมรี่ 2020' : 'e.g., Toyota Camry 2020'} />
                  </div>
                  <div className="flex gap-3">
                    <button onClick={() => setBookingStep(1)} className="flex-1 px-6 py-3 rounded-lg border border-slate-200 font-semibold hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors text-slate-800">
                      {t[language].back}
                    </button>
                    <button onClick={() => setBookingStep(3)} className="flex-1 px-6 py-3 rounded-lg bg-[#C5A059] text-white font-semibold hover:bg-[#B8935A] hover:scale-105 transition-all">
                      {t[language].next}
                    </button>
                  </div>
                </div>
              )}

              {/* Step 3: Date & Time */}
              {bookingStep === 3 && (
                <div className="space-y-4">
                  <div>
                    <label className="block text-sm font-medium mb-2">{t[language].step3Date}</label>
                    <MiniCalendar selectedDate={selectedDate} onSelectDate={setSelectedDate} />
                  </div>
                  <div>
                    <label className="block text-sm font-medium mb-2">{t[language].step3Time}</label>
                    <select className="w-full px-4 py-2 rounded-lg border border-zinc-300 dark:border-[#FBBF24] bg-white dark:bg-white text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-[#FBBF24]">
                      <option>9:00 AM</option>
                      <option>10:00 AM</option>
                      <option>11:00 AM</option>
                      <option>12:00 PM</option>
                      <option>1:00 PM</option>
                      <option>2:00 PM</option>
                      <option>3:00 PM</option>
                      <option>4:00 PM</option>
                      <option>5:00 PM</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-sm font-medium mb-2">{t[language].step3Notes}</label>
                    <textarea className="w-full px-4 py-2 rounded-lg border border-slate-200 bg-white dark:bg-slate-50 text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#3B82F6]" rows={3} placeholder={t[language].notesPlaceholder}></textarea>
                  </div>
                  <div className="flex gap-3">
                    <button onClick={() => setBookingStep(2)} className="flex-1 px-6 py-3 rounded-lg border border-slate-200 font-semibold hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors text-slate-800">
                      {t[language].back}
                    </button>
                    <button onClick={() => { setShowBooking(false); alert(language === 'th' ? 'จองสำเร็จ! เราจะติดต่อกลับเร็วๆ นี้' : 'Booking submitted! We will contact you shortly.'); }} className="flex-1 px-6 py-3 rounded-lg bg-[#C5A059] text-white font-semibold hover:bg-[#059669] hover:scale-105 transition-all">
                      {t[language].submit}
                    </button>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      )}

      {/* Map Modal */}
      {showMap && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4" onClick={() => setShowMap(false)}>
          <div className="bg-white dark:bg-white rounded-2xl max-w-4xl w-full overflow-hidden shadow-2xl" onClick={(e) => e.stopPropagation()}>
            <div className="p-4 border-b border-slate-200 flex items-center justify-between">
              <h3 className="text-xl font-bold text-[#1E293B] dark:text-white">{t[language].mapTitle}</h3>
              <button onClick={() => setShowMap(false)} className="text-2xl hover:bg-slate-100 dark:hover:bg-slate-700 w-8 h-8 rounded-lg transition-colors text-slate-800">×</button>
            </div>
            <div className="w-full h-[500px]">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3875.6449276897165!2d100.5237!3d13.7367!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTPCsDQ0JzEyLjEiTiAxMDDCsDMxJzI1LjMiRQ!5e0!3m2!1sen!2sth!4v1234567890"
                width="100%"
                height="100%"
                style={{ border: 0 }}
                allowFullScreen
                loading="lazy"
                referrerPolicy="no-referrer-when-downgrade"
              />
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
